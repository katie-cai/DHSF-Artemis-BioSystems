@st.cache_data(ttl=10)
def load_data():
    r = requests.get(
        SHEET_URL,
        params={"_": int(time.time())},
        headers={"Cache-Control": "no-cache", "Pragma": "no-cache"},
        timeout=20,
        allow_redirects=True,
    )
    r.raise_for_status()
    text = r.content.decode("utf-8-sig", errors="replace")
    if text.lstrip().lower().startswith(("<!doctype", "<html")):
        raise ValueError("Google returned a web page, not data. Set the sheet to "
                         "'Anyone with the link can view'.")
    return pd.read_csv(io.StringIO(text))


def parse_timestamps(dates, times):
    """Combine the sheet's Date and Time columns into one datetime column."""
    combined = dates.astype(str).str.strip() + " " + times.astype(str).str.strip()
    try:
        return pd.to_datetime(combined, errors="coerce", format="mixed")
    except (TypeError, ValueError):
        return pd.to_datetime(combined, errors="coerce")


