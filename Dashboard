        results = run_scan(REPORT_HOURS, st.session_state.refresh_token)
    except Exception as e:
        st.error(f"Data could not be loaded: {e}")
        return

    df = build_frame(results)
    if df.empty:
        st.info(f"No photos in the last {REPORT_HOURS} hours.")
        return

    total = len(df)
    identified = int(df["identified"].sum())
    unmatched = total - identified

    section("Summary")
    conf = df.loc[df["identified"], "confidence"].dropna()
    margin = df.loc[df["identified"], "margin"].dropna()
    avg_conf = f"{conf.mean() * 100:.1f}%" if not conf.empty else "n/a"
    weak = int((margin < 0.05).sum()) if not margin.empty else 0

    k1, k2, k3, k4, k5, k6 = st.columns(6)
    kpi(k1, "Photos", total)
    kpi(k2, "Identified", identified)
    kpi(k3, "No match", unmatched)
    kpi(k4, "Avg confidence", avg_conf)
    kpi(k5, "Weak matches", weak)
    kpi(k6, "Latest photo", df["taken"].iloc[0].strftime("%b %d, %I:%M %p"))

    exploded = df.explode("plants").dropna(subset=["plants"])
    plant_order = list(load_scanner()[1]["classes"])
    color_scale = alt.Scale(domain=plant_order, range=PALETTE[: len(plant_order)])

    if not exploded.empty:
        left, right = st.columns(2)

        with left:
            section("Photos by plant")
            counts = exploded["plants"].value_counts().rename_axis("plant").reset_index(name="photos")
            bar = (
                alt.Chart(counts)
                .mark_bar(size=46)
                .encode(
                    x=alt.X("plant:N", sort="-y", title=None, axis=alt.Axis(labelAngle=0)),
                    y=alt.Y("photos:Q", title=None, axis=alt.Axis(tickMinStep=1)),
                    color=alt.Color("plant:N", scale=color_scale, legend=None),
                    tooltip=[alt.Tooltip("plant:N", title="Plant"), alt.Tooltip("photos:Q", title="Photos")],
                )
                .properties(height=270)
                .configure_view(strokeWidth=0)
                .configure_axis(grid=True, gridColor="#e6e9ed", domain=False, labelColor="#55616e")
            )
            st.altair_chart(bar, width="stretch")

        with right:
            section("Activity (6-hour intervals)")
            ex = exploded.copy()
            ex["interval"] = ex["taken"].dt.floor("6h").dt.tz_localize(None)
            timeline = ex.groupby(["interval", "plants"]).size().reset_index(name="photos")
            area = (
                alt.Chart(timeline)
                .mark_bar()
                .encode(
                    x=alt.X("interval:T", title=None, axis=alt.Axis(format="%b %d %I %p", labelAngle=-30)),
                    y=alt.Y("photos:Q", title=None, axis=alt.Axis(tickMinStep=1)),
                    color=alt.Color("plants:N", scale=color_scale, legend=alt.Legend(title=None, orient="top")),
                    tooltip=[
                        alt.Tooltip("interval:T", title="Interval", format="%b %d, %I %p"),
                        alt.Tooltip("plants:N", title="Plant"),
                        alt.Tooltip("photos:Q", title="Photos"),
                    ],
                )
                .properties(height=270)
                .configure_view(strokeWidth=0)
                .configure_axis(grid=True, gridColor="#e6e9ed", domain=False, labelColor="#55616e")
            )
            st.altair_chart(area, width="stretch")

    section("Photo log")
    table = pd.DataFrame({
        "Taken": df["taken"].dt.strftime("%b %d, %I:%M %p"),
        "File": df["file"],
        "Result": df["result"],
        "Score": df["top_score"],
        "Cutoff": df["top_needs"],
        "Confidence": df["confidence"],
    })
    st.dataframe(
        table,
        hide_index=True,
        width="stretch",
        height=380,
        column_config={
            "Score": st.column_config.NumberColumn(format="%.3f"),
            "Cutoff": st.column_config.NumberColumn(format="%.3f"),
            "Confidence": st.column_config.ProgressColumn(
                format="%.3f", min_value=0.0, max_value=1.0,
            ),
        },
    )


live_tab, scan_tab, report_tab = st.tabs(["Live Dashboard", "Plant Scanner", "72-Hour Report"])

with live_tab:
    dashboard()

with scan_tab:
    scanner()

with report_tab:
    report_72h()
