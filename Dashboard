def get_drive_service():
    from google.oauth2 import service_account
    from googleapiclient.discovery import build

    creds = service_account.Credentials.from_service_account_file(
        SERVICE_ACCOUNT_FILE, scopes=DRIVE_SCOPES
    )
    return build("drive", "v3", credentials=creds, cache_discovery=False)


def list_jpgs(service, folder_id=FOLDER_ID):
    files, page_token = [], None
    query = (
        f"'{folder_id}' in parents and trashed = false "
        "and (mimeType = 'image/jpeg' or name contains '.jpg' or name contains '.jpeg')"
    )
    while True:
        resp = service.files().list(
            q=query,
            fields="nextPageToken, files(id, name, modifiedTime, createdTime, imageMediaMetadata(time))",
            pageSize=100,
            pageToken=page_token,
            orderBy="modifiedTime desc",
            supportsAllDrives=True,
            includeItemsFromAllDrives=True,
        ).execute()
        files.extend(resp.get("files", []))
        page_token = resp.get("nextPageToken")
        if not page_token:
            break
    return files


def download_image(service, file_id):
    from googleapiclient.http import MediaIoBaseDownload

    request = service.files().get_media(fileId=file_id, supportsAllDrives=True)
    buf = io.BytesIO()
    downloader = MediaIoBaseDownload(buf, request)
    done = False
    while not done:
        _, done = downloader.next_chunk()
    buf.seek(0)
    return Image.open(buf).convert("RGB")


def parse_photo_time(f):
    """When the photo was taken (local time) plus where that came from.
    Camera EXIF time if present, else Drive's createdTime. (None, None) if neither."""
    exif_time = (f.get("imageMediaMetadata") or {}).get("time")
    if exif_time:
        try:
            dt = datetime.strptime(exif_time.strip(), "%Y:%m:%d %H:%M:%S")
            return dt.replace(tzinfo=LOCAL_TZ), "camera"
        except ValueError:
            pass
    created = f.get("createdTime")
    if created:
        try:
            dt = datetime.fromisoformat(created.replace("Z", "+00:00"))
            return dt.astimezone(LOCAL_TZ), "drive_created"
        except ValueError:
            pass
    return None, None


def identify_plants(img, tie_margin=TIE_MARGIN):
    """Scores one photo against every plant model (shares the Scanner's loaded model)."""
    net, info = load_scanner()
    fps = get_fingerprints(net, make_crops(img))
    scores = fps @ info["protos"].T
    cutoffs = info["cutoffs"]
    class_best = scores.max(axis=0)
    margins = class_best - cutoffs
    strongest = margins.max()

    out = []
    for k, name in enumerate(info["classes"]):
        out.append({
            "plant": name,
            "similarity": round(float(class_best[k]), 3),
            "threshold": round(float(cutoffs[k]), 3),
            "crops": int((scores[:, k] >= cutoffs[k]).sum()),
            "match": bool(margins[k] >= 0 and margins[k] >= strongest - tie_margin),
            "_margin": float(margins[k]),
        })
    out.sort(key=lambda d: d["_margin"], reverse=True)
    for d in out:
        del d["_margin"]
    return out


def _load_cache():
    try:
        return json.loads(Path(CACHE_FILE).read_text())
    except Exception:
        return {}


def scan_drive(hours=None):
    """Identifies plants in the Drive photos taken in the last `hours` hours."""
    service = get_drive_service()
    cache = _load_cache()
    results = []

    files = list_jpgs(service)
    cutoff = datetime.now(LOCAL_TZ) - timedelta(hours=hours) if hours else None
    candidates = []
    for f in files:
        taken_dt, source = parse_photo_time(f)
        if cutoff and (taken_dt is None or taken_dt < cutoff):
            continue
        candidates.append((f, taken_dt, source))
    candidates.sort(key=lambda c: c[1] or datetime.min.replace(tzinfo=LOCAL_TZ), reverse=True)

    for f, taken_dt, source in candidates:
        key = f"{f['id']}|{f['modifiedTime']}"
        if key in cache:
            results.append(cache[key])
            continue
        try:
            img = download_image(service, f["id"])
            scores = identify_plants(img)
        except Exception as e:
            print(f"[error] {f['name']}: {e}")
            continue
        entry = {
            "file": f["name"],
            "id": f["id"],
            "modified": f["modifiedTime"],
            "taken": taken_dt.isoformat() if taken_dt else None,
            "taken_source": source,
            "plants": [s for s in scores if s["match"]],
            "scores": scores,
        }
        results.append(entry)
        cache[key] = entry

    Path(CACHE_FILE).write_text(json.dumps(cache))
    return results


@st.cache_data(ttl=300, show_spinner="Loading data")
def run_scan(hours: int, refresh_token: int):
    return scan_drive(hours=hours)


def build_frame(results):
    rows = []
    for r in results:
        rows.append({
            "file": r["file"],
            "id": r["id"],
            "taken": r["taken"],
            "source": r["taken_source"],
            "plants": [p["plant"] for p in r["plants"]],
            "top_score": r["scores"][0]["similarity"] if r["scores"] else None,
            "top_needs": r["scores"][0]["threshold"] if r["scores"] else None,
            "confidence": max((p["similarity"] for p in r["plants"]), default=None),
            "margin": max((p["similarity"] - p["threshold"] for p in r["plants"]), default=None),
            "plant_sims": {p["plant"]: p["similarity"] for p in r["plants"]},
        })
    df = pd.DataFrame(rows)
    if df.empty:
        return df
    df = df.dropna(subset=["taken"])
    if df.empty:
        return df
    df["taken"] = pd.to_datetime(df["taken"], utc=True).dt.tz_convert(LOCAL_TZ)
    df["identified"] = df["plants"].apply(len) > 0
    df["result"] = df.apply(
        lambda x: ", ".join(x["plants"]) if x["identified"] else "No match", axis=1
    )
    return df.sort_values("taken", ascending=False).reset_index(drop=True)


