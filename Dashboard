def model_status():
    found = [name for name, path in MODEL_FILES.items() if path.is_file()]
    missing = [name for name in MODEL_FILES if name not in found]
    return found, missing


@functools.lru_cache(maxsize=1)
def _build_scanner():
    import torch
    from torchvision import models

    net = models.mobilenet_v3_large(weights=models.MobileNet_V3_Large_Weights.DEFAULT)
    net.classifier = torch.nn.Identity()
    net.eval()
    classes, protos, cutoffs = [], [], []
    for plant, path in MODEL_FILES.items():
        if not path.is_file():
            continue
        data = torch.load(path, weights_only=False)
        if "prototypes" in data:
            classes += list(data["classes"])
            protos.append(np.asarray(data["prototypes"]))
            cutoffs.append(np.asarray(data["thresholds"]))
        else:
            classes.append(plant)
            protos.append(np.asarray(data["prototype"])[None, :])
            cutoffs.append(np.asarray([data["threshold"]]))
    if not classes:
        raise FileNotFoundError("No model files found next to AI_dashboard.py")
    cutoffs = np.maximum(np.concatenate(cutoffs), MIN_CONFIDENCE)
    return net, {"classes": classes, "protos": np.concatenate(protos), "cutoffs": cutoffs}


@st.cache_resource(show_spinner="Loading model...")
def load_scanner():
    return _build_scanner()


def make_crops(img):
    """The whole photo plus a 2x2 and a 3x3 grid of tiles, so several plants in one
    photo each get a chance to show up on their own."""
    img = ImageOps.exif_transpose(img).convert("RGB")
    w, h = img.size
    crops = [img]
    for n in (2, 3):
        for r in range(n):
            for c in range(n):
                box = (c * w // n, r * h // n, (c + 1) * w // n, (r + 1) * h // n)
                crops.append(img.crop(box))
    return crops


def get_fingerprints(net, imgs):
    import torch
    from torchvision import transforms

    prep = transforms.Compose([
        transforms.Resize(256),
        transforms.CenterCrop(224),
        transforms.ToTensor(),
        transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),
    ])
    batch = torch.stack([prep(i) for i in imgs])
    with torch.no_grad():
        vecs = net(batch)
    vecs = vecs / vecs.norm(dim=1, keepdim=True)
    return vecs.numpy()


def classify_multi(net, info, img, tie_margin=None):
    """Finds the known plant types in the photo using competitive voting.

    Each view (whole photo + tiles) votes for ONE plant: the one whose similarity is
    highest above its own cutoff. The vote only counts if that plant clears its cutoff
    and beats the runner-up by at least WIN_MARGIN. A plant is identified only if it
    wins at least MIN_VIEWS views. Look-alike cultivars therefore can't pass on a single
    lucky tile; the real plant wins many views, a look-alike wins few or none.

    Returns (detections, closest, class_best):
      detections: list of dicts {label, score, cutoff, crops}, most views first
                  ("crops" = number of views this plant won)
      closest:    (label, score, cutoff) for the best overall fit, even if not matched
      class_best: best score seen for each known plant, same order as info["classes"]
    """
    fps = get_fingerprints(net, make_crops(img))
    scores = fps @ info["protos"].T
    cutoffs = info["cutoffs"]
    class_best = scores.max(axis=0)

    over = scores - cutoffs
    n_views, n_cls = over.shape
    winner = over.argmax(axis=1)
    if n_cls > 1:
        srt = np.sort(over, axis=1)
        gap = srt[:, -1] - srt[:, -2]
    else:
        gap = np.full(n_views, np.inf)

    wins = np.zeros(n_cls, dtype=int)
    for v in range(n_views):
        if over[v, winner[v]] >= 0 and gap[v] >= WIN_MARGIN:
            wins[winner[v]] += 1

    LAST_DEBUG.clear()
    LAST_DEBUG.update({
        "classes": list(info["classes"]),
        "wins": wins.tolist(),
        "views_above_cutoff": (over >= 0).sum(axis=0).tolist(),
        "best_gap": float(gap[np.isfinite(gap)].max()) if np.isfinite(gap).any() else 0.0,
        "median_gap": float(np.median(gap[np.isfinite(gap)])) if np.isfinite(gap).any() else 0.0,
    })

    detections = []
    for k, label in enumerate(info["classes"]):
        if wins[k] >= MIN_VIEWS:
            detections.append({
                "label": label,
                "score": float(class_best[k]),
                "cutoff": float(cutoffs[k]),
                "crops": int(wins[k]),
            })
    detections.sort(key=lambda d: d["crops"], reverse=True)

    margins = class_best - cutoffs
    k = int(margins.argmax())
    closest = (info["classes"][k], float(class_best[k]), float(cutoffs[k]))
    return detections, closest, class_best


def meter_html(score, cutoff):
    fill = max(0.0, min(1.0, score)) * 100
    mark = max(0.0, min(1.0, cutoff)) * 100
    return (
        f'<div class="meter"><div class="fill" style="width:{fill:.1f}%"></div>'
        f'<div class="mark" style="left:{mark:.1f}%"></div></div>'
        '<div class="scale"><span>0.0 no match</span>'
        '<span>cutoff</span><span>strong match 1.0</span></div>'
    )


